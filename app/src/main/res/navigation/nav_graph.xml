<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.curs_alexander.ui.onboarding.OnboardingFragment"
        android:label="Onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.curs_alexander.ui.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profileFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.curs_alexander.ui.home.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/healthMeasurementsFragment"
        android:name="com.example.curs_alexander.ui.measurements.HealthMeasurementsFragment"
        android:label="HealthMeasurements" />

    <fragment
        android:id="@+id/healthMeasurementAddFragment"
        android:name="com.example.curs_alexander.ui.measurements.HealthMeasurementAddFragment"
        android:label="HealthMeasurementAdd">
        <argument
            android:name="initialType"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/healthMeasurementsChartFragment"
        android:name="com.example.curs_alexander.ui.measurements.HealthMeasurementsChartFragment"
        android:label="HealthMeasurementsChart" />

    <fragment
        android:id="@+id/symptomsListFragment"
        android:name="com.example.curs_alexander.ui.symptoms.SymptomsListFragment"
        android:label="SymptomsList">
        <action
            android:id="@+id/action_symptomsListFragment_to_symptomAddFragment"
            app:destination="@id/symptomAddFragment" />
    </fragment>

    <fragment
        android:id="@+id/symptomAddFragment"
        android:name="com.example.curs_alexander.ui.symptoms.SymptomAddFragment"
        android:label="SymptomAdd" />

    <fragment
        android:id="@+id/analysisFragment"
        android:name="com.example.curs_alexander.ui.analysis.AnalysisFragment"
        android:label="Analysis" />

    <fragment
        android:id="@+id/remindersFragment"
        android:name="com.example.curs_alexander.ui.reminders.RemindersFragment"
        android:label="Reminders">
        <argument
            android:name="openAddDialog"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.example.curs_alexander.ui.analytics.AnalyticsFragment"
        android:label="Analytics" />

    <fragment
        android:id="@+id/medicalCardFragment"
        android:name="com.example.curs_alexander.ui.medicalcard.MedicalCardFragment"
        android:label="MedicalCard" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.curs_alexander.ui.settings.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/privacySecurityFragment"
        android:name="com.example.curs_alexander.ui.settings.PrivacySecurityFragment"
        android:label="Безопасность и конфиденциальность" />

    <fragment
        android:id="@+id/educationListFragment"
        android:name="com.example.curs_alexander.ui.education.EducationListFragment"
        android:label="@string/education_screen_title" />

    <fragment
        android:id="@+id/educationArticleFragment"
        android:name="com.example.curs_alexander.ui.education.EducationArticleFragment"
        android:label="@string/education_screen_title">
        <argument
            android:name="articleId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/userParamsFragment"
        android:name="com.example.curs_alexander.ui.userparams.UserParamsFragment"
        android:label="@string/user_params_title" />

    <fragment
        android:id="@+id/dataStatusFragment"
        android:name="com.example.curs_alexander.ui.datastatus.DataStatusFragment"
        android:label="@string/data_status_title" />

</navigation>
