<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Токены для читаемости текста.
      Material-токены (colorOnSurfaceVariant и т.п.) в некоторых сочетаниях фон/устройство
      могут визуально "проваливаться" (особенно на очень светлых surface-оверах).

      Поэтому вводим собственный вторичный цвет текста с чуть большим контрастом.

      Примечание: здесь используем alpha-версии от чёрного/белого как надёжный дефолт,
      т.к. тема у проекта сейчас стандартная Theme.Material3.DayNight без кастомной палитры.
    -->

    <!-- Вторичный текст на светлой теме (чуть темнее стандартного variant) -->
    <color name="app_text_secondary_light">#99000000</color> <!-- 60% black -->

    <!-- Вторичный текст на тёмной теме (чуть ярче стандартного variant) -->
    <color name="app_text_secondary_dark">#B3FFFFFF</color> <!-- 70% white -->
</resources>

